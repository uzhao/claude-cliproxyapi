{
  "name": "claude-cliproxyapi",
  "displayName": "Claude CLIProxyAPI Switch",
  "description": "One-click switch for Claude Code between the local CLIProxyAPI proxy and the official API via settings.json",
  "version": "0.0.4",
  "publisher": "uzhao",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "cliproxyapi",
    "proxy",
    "model"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeCliProxy.toggleProxy",
        "title": "Claude CLIProxyAPI: 切换代理"
      }
    ],
    "configuration": [
      {
        "title": "Claude CLIProxyAPI",
        "properties": {
          "claudeCliProxy.baseUrl": {
            "type": "string",
            "default": "http://127.0.0.1:8317",
            "description": "本地 CLIProxyAPI 地址（不含 /v1）",
            "scope": "machine"
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test \"out/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}